# Server Configuration
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://erfurtpizza.com

# PayPal Configuration
# Get credentials from: https://developer.paypal.com/dashboard/
PAYPAL_MODE=sandbox
# Use 'sandbox' for testing, 'live' for production
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# Stripe Configuration
# Get credentials from: https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) for testing, live keys (sk_live_...) for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Database (Optional - for production with persistent storage)
# Uncomment if using PostgreSQL
# DATABASE_URL=postgresql://user:password@host:5432/erfurt_pizza

# Webhook Secrets (Optional but recommended for production)
# Get from Stripe Dashboard: Developers → Webhooks
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
