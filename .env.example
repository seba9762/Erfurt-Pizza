# =====================================================
# ERFURT PIZZA - ENVIRONMENT VARIABLES TEMPLATE
# =====================================================
# Copy this file to .env for local development
# For production, set these in Netlify Dashboard → Site settings → Environment variables

# =====================================================
# SUPABASE CONFIGURATION
# =====================================================
# Get these from: https://app.supabase.com/project/_/settings/api

# Your Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon/public API key (safe to use in frontend)
SUPABASE_ANON_KEY=your-anon-key-here

# =====================================================
# PAYPAL CONFIGURATION (Optional)
# =====================================================
# Get these from: https://developer.paypal.com/dashboard/applications

# PayPal Client ID
PAYPAL_CLIENT_ID=your-paypal-client-id-here

# PayPal Client Secret (NEVER expose in frontend!)
PAYPAL_CLIENT_SECRET=your-paypal-client-secret-here

# PayPal Mode: 'sandbox' for testing, 'live' for production
PAYPAL_MODE=sandbox

# =====================================================
# STRIPE CONFIGURATION (Optional)
# =====================================================
# Get these from: https://dashboard.stripe.com/apikeys

# Stripe Secret Key (NEVER expose in frontend!)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here

# Stripe Publishable Key (safe to use in frontend)
# Note: You can also set this directly in payment-config.js
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# =====================================================
# NETLIFY CONFIGURATION
# =====================================================
# These are automatically set by Netlify, but you can override for local dev

# Your Netlify site URL (automatically set by Netlify)
URL=https://your-site-name.netlify.app

# Deploy URL (automatically set by Netlify)
DEPLOY_PRIME_URL=https://your-site-name.netlify.app

# =====================================================
# SECURITY CONFIGURATION (Optional)
# =====================================================

# Admin dashboard password (if using simple password protection)
ADMIN_PASSWORD=your-secure-admin-password-here

# JWT secret for admin authentication (if implementing custom auth)
JWT_SECRET=your-jwt-secret-here

# =====================================================
# NOTES
# =====================================================
#
# IMPORTANT SECURITY NOTES:
# - NEVER commit .env file to git (it's in .gitignore)
# - NEVER expose secret keys in frontend code
# - Always use environment variables for sensitive data
# - Use strong, random passwords for admin access
#
# SETUP INSTRUCTIONS:
#
# 1. LOCAL DEVELOPMENT:
#    - Copy this file to .env
#    - Fill in your credentials
#    - Install Netlify CLI: npm install -g netlify-cli
#    - Run: netlify dev (this will use .env variables)
#
# 2. NETLIFY PRODUCTION:
#    - Go to: Netlify Dashboard → Your Site → Site settings → Environment variables
#    - Add each variable from this template
#    - Redeploy your site for changes to take effect
#
# 3. SUPABASE SETUP:
#    - Create a new project at https://app.supabase.com
#    - Run the SQL schema from supabase-schema.sql in the SQL Editor
#    - Copy the URL and anon key from Settings → API
#
# 4. PAYMENT GATEWAY SETUP (Optional):
#    - PayPal: Create app at https://developer.paypal.com/dashboard
#    - Stripe: Get keys from https://dashboard.stripe.com/apikeys
#    - Start with sandbox/test mode, switch to live when ready
#
